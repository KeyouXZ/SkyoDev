# PostgreSQL Database connection string (single database for app data, sessions & push subscriptions)
DATABASE_URL="postgresql://postgres:password@localhost:5432/skyodev?schema=public"

# Web Push Notification VAPID Keys
# Generate new keys with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_EMAIL="mailto:admin@your.my.id"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
